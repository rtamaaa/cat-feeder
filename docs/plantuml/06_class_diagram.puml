@startuml Class_Diagram
!theme plain
skinparam backgroundColor #FFFFFF
skinparam classAttributeIconSize 0

title Class Diagram: Arsitektur Objek Web Administrator & Firmware

package "Web Administrator Frontend (app/frontend/index.html)" {
    
    class WebAdminController {
        + serverUrl : String
        + token : String
        + username : String
        + deviceId : String
        + currentPage : String
        + isRegister : Boolean
        + wifiApMode : Boolean
        + slots : Array
        + dashTimer : Timer
        + api(method, path, body) : Promise
        + goPage(page: String) : void
        + refreshPage() : void
        + doAuth() : Promise
        + showMain() : void
        + doLogout() : void
        + startDashPoll() : void
        + fetchDashStatus() : Promise
        + fetchDashLog() : Promise
        + sendFeed() : Promise
        + syncRtc() : Promise
        + loadSchedule() : Promise
        + addSlot() : void
        + saveSchedule() : Promise
        + loadServoSettings() : Promise
        + saveServo() : Promise
        + loadServoHistory() : Promise
        + loadHistory() : Promise
        + setWifiMode(isAp: Boolean) : void
        + sendWifi() : Promise
    }

    class ScheduleSlotComponent {
        + id : String
        + slotNumber : Int
        + enabled : Boolean
        + hour : Int
        + minute : Int
        + toggle() : void
        + delete() : void
        + formatTime() : void
    }

    WebAdminController *-- ScheduleSlotComponent
}

package "NodeMCU ESP8266 Firmware (app/nodemcu/nodemcu.ino)" {
    
    class FeederFirmware <<ESP8266 Engine>> {
        - servoCloseAngle : int = 0
        - servoOpenAngle : int = 90
        - feedDurationMs : int = 2000
        - feedingState : FeedingState
        - feedStartTime : unsigned long
        - schedules : Schedule[6]
        - rtc : RTC_DS3231
        - feederServo : Servo
        + setup() : void
        + loop() : void
        + handleServerPolling() : void
        + handleHeartbeat() : void
        + handleScheduleCheck() : void
        + handleServoStateMachine() : void
        + startFeeding(slot: int) : void
        + loadConfigFromFS() : void
        + saveConfigToFS() : void
    }

    enum FeedingState {
        IDLE
        OPENING
        HOLDING
        CLOSING
        SETTLING
    }

    struct Schedule {
        + enabled : bool
        + hour : int
        + minute : int
        + lastFedDay : int
    }

    FeederFirmware *-- FeedingState
    FeederFirmware *-- Schedule
}

@enduml
